rules_version = '2';

// Geosan Cup draft. Paste into Firebase console → Firestore Database → Rules, after
// checking that the UID in isAdmin() is the admin's User UID (Authentication → Users).
//
// - Anyone can read draft/main (men) and draft/women, so spectators can watch without logging in.
// - The admin can read and change everything, including draft/private and draft/private_women
//   (captain emails). Any other document under draft/ is admin only.
// - A captain (a UID listed in the draft's `captains` map) can only append one pick:
//   for their own team, when it is their turn, of an undrafted player.
// - Nobody else can write anything.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'NIrCTa6UI3WNxj586RN5JHzxFe83';
    }

    function isCaptain(d) {
      return request.auth != null && request.auth.uid in d.captains.values();
    }

    function validCaptainPick() {
      let b = resource.data;
      let a = request.resource.data;
      let n = b.picks.size();
      let tid = b.pickOrder[n];
      let p = a.picks[n];
      return b.stage == 'draft'
        && n < b.pickOrder.size()
        && b.captains[tid] == request.auth.uid
        && a.diff(b).affectedKeys().hasOnly(['picks', 'draftedIds', 'turnStartedAt'])
        && a.picks.size() == n + 1
        && (n == 0 || a.picks[0:n] == b.picks)
        && p.keys().hasOnly(['playerId', 'teamId', 'by'])
        && p.teamId == tid
        && p.by == request.auth.uid
        && p.playerId in b.players
        && !(p.playerId in b.draftedIds)
        && a.draftedIds == b.draftedIds.concat([p.playerId])
        && a.turnStartedAt == request.time;
    }

    // draft/main (men) and draft/women: public, captains may add their own picks
    match /draft/{id} {
      allow read: if id in ['main', 'women'] || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (id in ['main', 'women'] && isCaptain(resource.data) && validCaptainPick());
    }
  }
}
